---
import Base from "../layouts/Base.astro";
import Citation from "../components/Citation.astro";
import { profile } from "../data/profile";
import { getCollection } from "astro:content";
import { dateKey, firstYear } from "../lib/dates";

const selected = (await getCollection("publications"))
  .filter((p) => p.data.featured)
  .sort((a, b) => dateKey(b.data) - dateKey(a.data));

const software = (await getCollection("software"))
  .filter((s) => s.data.tier === "major")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const fullName = `${profile.firstName} ${profile.lastName}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: fullName,
  givenName: profile.firstName,
  familyName: profile.lastName,
  url: "https://sofiafdzl.com/",
  jobTitle: profile.position,
  worksFor: { "@type": "Organization", name: profile.affiliationFull },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "McGill University" },
    { "@type": "CollegeOrUniversity", name: "Universidad Nacional Autónoma de México" },
    { "@type": "CollegeOrUniversity", name: "Universidad Autónoma de Baja California" },
  ],
  knowsAbout: profile.themes,
  email: `mailto:${profile.info.email}`,
  identifier: { "@type": "PropertyValue", propertyID: "ORCID", value: profile.info.orcid },
  sameAs: [
    `https://orcid.org/${profile.info.orcid}`,
    `https://github.com/${profile.info.github}`,
  ],
};
---
<Base jsonLd={jsonLd}>
  <header class="hero">
    <h1 class="hero__name">{fullName}</h1>
    <p class="hero__role">{profile.position} · {profile.affiliation}, {profile.city}</p>
    <p class="hero__themes">{profile.themes.join(" · ")}</p>
  </header>

  <div class="doc">
    <h2 class="doc__label">About</h2>
    <div class="doc__body prose">
      <p>
        I am a postdoctoral fellow at the Centre for Studies on the
        Prevention of Alzheimer's Disease (StoP-AD), Douglas Research
        Centre, working with Sylvia Villeneuve. I use structural equation
        modeling to study cardiovascular risk in preclinical Alzheimer's
        disease.
      </p>
      <p>
        I did my PhD with D. Louis Collins at the Montreal Neurological
        Institute. Much of it was on the hippocampal-to-ventricle ratio
        (HVR), a measure of atrophy that does not depend on head size. I
        automated its calculation and validated it in a large population
        sample, the UK Biobank, and in clinical cohorts of Alzheimer's and
        Parkinson's disease. I also wrote Qrater, a web application for
        quality control of large MRI datasets, which several other labs
        now use.
      </p>
      <p>
        Before moving to Montréal in 2020, I studied psychology in Tijuana,
        focusing on neuropsychology and psychometrics, and then neurobiology
        at UNAM, where my master's research looked at changes in brain
        connectivity after transcranial magnetic stimulation in people with
        cocaine dependence.
      </p>
    </div>

    <h2 class="doc__label">Selected publications</h2>
    <div class="doc__body">
      {selected.map((pub) => <Citation pub={pub} showDoi={false} />)}
      <p class="more"><a href="/publications">All publications →</a></p>
    </div>

    <h2 class="doc__label">Software</h2>
    <div class="doc__body">
      {software.map((s) => {
        const links: { label: string; url: string }[] = [];
        if (s.data.links?.github) links.push({ label: "GitHub", url: s.data.links.github });
        if (s.data.links?.paper) links.push({ label: "Paper", url: s.data.links.paper });
        return (
          <div class="item">
            <span class="item__year">{firstYear(s.data.period)}–</span>
            <div class="item__body">
              <span class="item__title"><a class="item__link" href={`/software#${s.id}`}>{s.data.name}</a></span>
              {s.data.tagline && <span class="item__meta">{s.data.tagline}</span>}
              {links.length > 0 && (
                <span class="item__links">
                  {links.map((link, i) => <>{i > 0 && " · "}<a href={link.url}>{link.label}</a></>)}
                </span>
              )}
            </div>
          </div>
        );
      })}
      <p class="more"><a href="/software">More on software →</a></p>
    </div>
  </div>
</Base>
