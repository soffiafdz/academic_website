---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { years } from "../lib/years";

const yearOf = (s: string) => parseInt((s.match(/\d{4}/g) ?? ["0"]).pop()!);

const education = (await getCollection("education")).sort(
  (a, b) => yearOf(b.data.year) - yearOf(a.data.year)
);

const honours = (await getCollection("honours")).sort(
  (a, b) =>
    (a.data.order ?? 99) - (b.data.order ?? 99) ||
    yearOf(b.data.year) - yearOf(a.data.year)
);
---
<Base title="About" description="Background, education, and honours.">
  <section class="page-head">
    <div class="divider">
      <span class="eyebrow">About</span>
      <h1 class="divider__title">Background</h1>
    </div>
  </section>

  <section class="prose intro">
    <p>
      I studied psychology in Tijuana, focusing on neuropsychology and
      psychometrics. For my master's in neurobiology at UNAM, I studied
      changes in brain connectivity after transcranial magnetic
      stimulation in people with cocaine dependence.
    </p>
    <p>
      Since 2020 I have been at the Montreal Neurological Institute,
      supervised by D. Louis Collins. The work is methodological:
      automated segmentation pipelines, normative models of brain
      structure, and quality-control tools for large multi-site MRI
      studies, most of it centred on the hippocampus and lateral
      ventricles as markers of neurodegeneration in Alzheimer's disease.
    </p>
  </section>

  <div class="facts">
    <section class="facts__block">
      <h2 class="facts__head">Education</h2>
      {education.map((e) => (
        <div class="line">
          <span class="line__year">{years(e.data.year)}</span>
          <p class="line__text">
            <span class="line__lead">{e.data.degree}</span>
            <span class="line__sub">
              {e.data.institution}{e.data.honours && ` · ${e.data.honours}`}
            </span>
          </p>
        </div>
      ))}
    </section>

    <section class="facts__block">
      <h2 class="facts__head">Honours</h2>
      {honours.map((h) => (
        <div class="line">
          <span class="line__year">{years(h.data.year)}</span>
          <p class="line__text">
            <span class="line__lead">{h.data.title}</span>
          </p>
        </div>
      ))}
    </section>
  </div>

  <footer class="footer">
    Positions, service, and the full record are on the <a href="/cv">CV</a>.
  </footer>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-8);
    max-width: var(--prose-width);
  }
  .intro p { font-size: var(--text-md); }

  /* Two tight credential lists side by side — degrees and honours.
     One line per entry; the CV carries the full detail. */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7);
    max-width: 56rem;
  }
  .facts__head {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-3) 0;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-rule);
  }
  .line {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: baseline;
    padding: 0.3rem 0;
  }
  .line__year {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .line__text { margin: 0; line-height: var(--lh-snug); }
  .line__lead { display: block; }
  .line__sub {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (max-width: 720px) {
    .facts { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
