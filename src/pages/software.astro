---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { md } from "../lib/md";
import { firstYear } from "../lib/dates";

const all = await getCollection("software");
const major = all
  .filter((s) => s.data.tier === "major")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const group = all.filter((s) => s.data.tier === "group");
---
<Base
  title="Software"
  description="Open-source research software by Sofía Fernández Lozano: the HVR pipeline and Qrater, a collaborative MRI quality-control application."
>
  <PageHeader title="Software" lede="Open-source research tools, with their code and releases." />

  <div class="doc">
    <h2 class="doc__label">Research tools</h2>
    <div class="doc__body">
      {major.map((s) => {
        const links: { label: string; url: string }[] = [];
        if (s.data.links?.github) links.push({ label: "GitHub", url: s.data.links.github });
        if (s.data.links?.docker) links.push({ label: "Docker Hub", url: s.data.links.docker });
        if (s.data.links?.paper) links.push({ label: "Paper", url: s.data.links.paper });
        const meta = [s.data.tagline, s.data.role].filter(Boolean).join(" · ");
        return (
          <article class="item" id={s.id}>
            <span class="item__year">{firstYear(s.data.period)}–</span>
            <div class="item__body">
              <h3 class="item__title item__title--lg">{s.data.name}</h3>
              {meta && <p class="item__meta">{meta}</p>}
              <ul>{s.data.bullets.map((b) => <li set:html={md(b)}></li>)}</ul>
              {links.length > 0 && (
                <p class="item__links">
                  {links.map((link, i) => <>{i > 0 && " · "}<a href={link.url}>{link.label}</a></>)}
                </p>
              )}
            </div>
          </article>
        );
      })}
    </div>

    {group.length > 0 && (
      <>
        <h2 class="doc__label">Hackathons</h2>
        <div class="doc__body">
          {group.map((s) => (
            <div class="item">
              <span class="item__year">{s.data.period}</span>
              <div class="item__body">
                <ul class="first">{s.data.bullets.map((b) => <li set:html={md(b)}></li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</Base>

<style>
  article { scroll-margin-top: var(--space-5); }
  article + article { margin-top: var(--space-6); }
  /* The hackathon list is the entry itself; no gap above it. */
  .first { margin-top: 0; font-size: var(--text-base); }
</style>
