---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Citation from "../components/Citation.astro";
import { getCollection } from "astro:content";
import { dateKey } from "../lib/dates";

const all = await getCollection("publications");

// Preprints lead: they are the most recent and most time-sensitive, and
// they move into Articles once published.
const groups = [
  { id: "preprints", label: "Preprints", types: ["preprint"] },
  { id: "articles", label: "Articles & book chapter", types: ["article", "chapter"] },
  { id: "conference", label: "Conference publications", types: ["conference"] },
  { id: "posters", label: "Posters", types: ["poster"] },
  { id: "talks", label: "Talks", types: ["talk"] },
]
  .map((g) => ({
    ...g,
    items: all
      .filter((p) => g.types.includes(p.data.type))
      .sort((a, b) => dateKey(b.data) - dateKey(a.data)),
  }))
  .filter((g) => g.items.length > 0);
---
<Base
  title="Publications"
  description="Articles, preprints, conference abstracts, posters, and talks by Sofía Fernández Lozano on MRI biomarkers of neurodegeneration and Alzheimer's disease."
>
  <PageHeader title="Publications" lede="Linked titles open the version of record.">
    <ul class="toc" aria-label="Sections">
      {groups.map((g) => (
        <li><a href={`#${g.id}`}>{g.label}</a><span class="toc__n">{g.items.length}</span></li>
      ))}
    </ul>
  </PageHeader>

  <div class="doc">
    {groups.map((group) => (
      <>
        <h2 class="doc__label" id={group.id}>{group.label}</h2>
        <div class="doc__body">
          {group.items.map((pub) => <Citation pub={pub} />)}
        </div>
      </>
    ))}
  </div>
</Base>
